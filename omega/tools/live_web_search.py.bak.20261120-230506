def _tor_socks_addr() -> tuple[str, int] | None:
    host = os.environ.get("IAO_TOR_SOCKS_HOST", "127.0.0.1").strip() or "127.0.0.1"
    raw_port = os.environ.get("IAO_TOR_SOCKS_PORT", "9050").strip() or "9050"
    try:
        port = int(raw_port)
    except ValueError:
        return None
    try:
        with socket.create_connection((host, port), timeout=1.0):
            return (host, port)
    except OSError:
        return None


def _http_get_json_via_socks5(url: str, socks_addr: tuple[str, int], timeout: float = 10.0) -> Any:
    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname
    if not host:
        raise ValueError("URL sin host")
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    path = parsed.path or "/"
    if parsed.query:
        path = f"{path}?{parsed.query}"

    sock = socket.create_connection(socks_addr, timeout=timeout)
    try:
        sock.settimeout(timeout)
        sock.sendall(b"\x05\x01\x00")
        resp = sock.recv(2)
        if resp != b"\x05\x00":
            raise RuntimeError("Fallo handshake SOCKS5 con Tor")

        host_bytes = host.encode("utf-8")
        if len(host_bytes) > 255:
            raise ValueError("Host demasiado largo para SOCKS5")
        req = b"\x05\x01\x00\x03" + bytes([len(host_bytes)]) + host_bytes + struct.pack("!H", port)
        sock.sendall(req)
        s_resp = sock.recv(4)
        if len(s_resp) < 2 or s_resp[1] != 0x00:
            raise RuntimeError("Fallo conexion SOCKS5 destino")
        atyp = s_resp[3] if len(s_resp) > 3 else 0
        if atyp == 0x01:
            sock.recv(6)
        elif atyp == 0x03:
            ln = sock.recv(1)[0]
            sock.recv(ln + 2)
        elif atyp == 0x04:
            sock.recv(18)

        stream = sock
        if parsed.scheme == "https":
            import ssl
            ctx = ssl.create_default_context()
            stream = ctx.wrap_socket(sock, server_hostname=host)

        http_req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host}\r\n"
            f"User-Agent: {USER_AGENT}\r\n"
            f"Accept: application/json, text/plain, */*\r\n"
            f"Accept-Encoding: identity\r\n"
            f"Connection: close\r\n\r\n"
        ).encode("utf-8")
        stream.sendall(http_req)

        chunks = []
        total = 0
        while total < 1_200_000:
            data = stream.recv(16384)
            if not data:
                break
            chunks.append(data)
            total += len(data)
        raw_bytes = b"".join(chunks)
        if hasattr(stream, "unwrap"):
            try:
                stream.close()
            except Exception:
                pass
        else:
            stream.close()

        split_idx = raw_bytes.find(b"\r\n\r\n")
        body = raw_bytes[split_idx + 4:] if split_idx != -1 else raw_bytes
        text = body.decode("utf-8", errors="replace").strip()
        if text.startswith("{") or text.startswith("["):
            return json.loads(text)
        return {"raw_text": text[:1000]}
    finally:
        try:
            sock.close()
        except Exception:
            pass



def _socks5_fetch_html(url: str, socks_addr: tuple[str, int], timeout: float = 10.0) -> str:
    import socket, urllib.parse
    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    path_qs = (parsed.path or "/") + (f"?{parsed.query}" if parsed.query else "")
    if not host:
        return ""
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(socks_addr)
        s.sendall(b"\x05\x01\x00")
        resp = s.recv(2)
        if len(resp) < 2 or resp[0] != 5 or resp[1] != 0:
            return ""
        h_bytes = host.encode("utf-8")
        req_socks = b"\x05\x01\x00\x03" + bytes([len(h_bytes)]) + h_bytes + int(port).to_bytes(2, "big")
        s.sendall(req_socks)
        r2 = s.recv(10)
        if len(r2) < 2 or r2[0] != 5 or r2[1] != 0:
            return ""
        conn = s
        if parsed.scheme == "https":
            import ssl
            ctx = ssl.create_default_context()
            conn = ctx.wrap_socket(s, server_hostname=host)
            conn.settimeout(timeout)
        http_req = (
            f"GET {path_qs} HTTP/1.1\r\n"
            f"Host: {host}\r\n"
            "User-Agent: Mozilla/5.0 (IAO-Omega/1.0)\r\n"
            "Accept: text/html,application/xhtml+xml,*/*;q=0.8\r\n"
            "Connection: close\r\n\r\n"
        ).encode("utf-8")
        conn.sendall(http_req)
        chunks = []
        while True:
            data = conn.recv(8192)
            if not data:
                break
            chunks.append(data)
            if sum(len(c) for c in chunks) > 512_000:
                break
        raw = b"".join(chunks).decode("utf-8", errors="replace")
        parts = raw.split("\r\n\r\n", 1)
        return parts[1] if len(parts) == 2 else raw
    finally:
        try:
            s.close()
        except Exception:
            pass

def _tor_network_search(query: str, timeout: float = 10.0) -> list[dict[str, str]]:
    socks_addr = _tor_socks_addr()
    if not socks_addr:
        return []
    out: list[dict[str, str]] = []
    q_enc = urllib.parse.quote_plus(query.strip())
    tor_eps = [u.strip() for u in os.environ.get("IAO_TOR_ENDPOINTS", "").split(",") if u.strip()]
    for tpl in tor_eps:
        target = tpl.replace("{query}", q_enc) if "{query}" in tpl else f"{tpl}{'&' if '?' in tpl else '?'}q={q_enc}"
        try:
            payload = _http_get_json_via_socks5(target, socks_addr, timeout=timeout)
            if isinstance(payload, dict):
                rows = payload.get("results") or payload.get("items") or payload.get("data") or []
                if rows and isinstance(rows, list):
                    for r in rows[:3]:
                        if isinstance(r, dict):
                            snip = str(r.get("snippet") or r.get("content") or r.get("description") or r.get("title") or "").strip()
                            if snip:
                                out.append({
                                    "source": str(r.get("url") or r.get("source") or target).strip(),
                                    "title": str(r.get("title") or query).strip()[:120],
                                    "snippet": snip[:450],
                                    "engine": "tor-socks5",
                                })
                elif payload.get("raw_text"):
                    out.append({
                        "source": target,
                        "title": f"Tor endpoint ({socks_addr[0]}:{socks_addr[1]})",
                        "snippet": str(payload["raw_text"])[:450],
                        "engine": "tor-socks5",
                    })
        except Exception:
            continue

    if not out:
        try:
            html_doc = _socks5_fetch_html(
                f"https://html.duckduckgo.com/html/?q={q_enc}",
                socks_addr,
                timeout=timeout,
            )
            if html_doc:
                import re, html as _html
                links = re.findall(r'class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', html_doc, flags=re.S)
                snips = re.findall(r'class="result__snippet"[^>]*>(.*?)</', html_doc, flags=re.S)
                for idx_r, (href, title_raw) in enumerate(links[:3]):
                    clean_t = _html.unescape(re.sub(r"<[^>]+>", "", title_raw)).strip()
                    clean_s = _html.unescape(re.sub(r"<[^>]+>", "", snips[idx_r] if idx_r < len(snips) else "")).strip()
                    if clean_t or clean_s:
                        out.append({
                            "source": _html.unescape(href).strip(),
                            "title": (clean_t or query)[:120],
                            "snippet": (clean_s or clean_t)[:450],
                            "engine": "tor-socks5",
                        })
        except Exception:
            pass
    return out


def _custom_endpoints_search(query: str, timeout: float = 8.0) -> list[dict[str, str]]:
    raw_env = os.environ.get("IAO_SEARCH_ENDPOINTS", "").strip()
    if not raw_env:
        return []
    results: list[dict[str, str]] = []
    q_enc = urllib.parse.quote_plus(query.strip())
    for tpl in [u.strip() for u in raw_env.split(",") if u.strip()]:
        if not (tpl.startswith("https://") or tpl.startswith("http://")):
            continue
        target = tpl.replace("{query}", q_enc) if "{query}" in tpl else f"{tpl}{'&' if '?' in tpl else '?'}q={q_enc}"
        try:
            payload = _http_get_json(target, timeout=timeout)
            if isinstance(payload, dict):
                candidates = payload.get("results") or payload.get("items") or payload.get("data") or []
            elif isinstance(payload, list):
                candidates = payload
            else:
                candidates = []
            for row in candidates[:3]:
                if not isinstance(row, dict):
                    continue
                src = str(row.get("url") or row.get("link") or row.get("source") or target).strip()
                title = str(row.get("title") or row.get("name") or query).strip()[:120]
                snip = str(row.get("snippet") or row.get("content") or row.get("description") or "").strip()[:450]
                if snip:
                    results.append({
                        "source": src,
                        "title": title,
                        "snippet": snip,
                        "engine": "custom-endpoint",
                    })
        except Exception:
            continue
    return results



def _weather_search(query: str, timeout: float = 8.0) -> list[dict[str, str]]:
    plain = _strip_accents(query).lower()
    weather_keys = ("temperatura", "clima", "tiempo", "lluvia", "humedad", "weather", "temperature", "forecast")
    if not any(k in plain for k in weather_keys):
        return []
    m = re.search(r"\b(?:en|in)\s+([a-záéíóúüñA-ZÁÉÍÓÚÜÑ\s]{2,35}?)(?:\s+(?:hoy|ahora|manana|mañana|de|el|la|\d)|$)", query, re.IGNORECASE)
    city = (m.group(1) if m else "").strip()
    if not city:
        for cand in ("caracas", "barquisimeto", "madrid", "bogota", "buenos aires", "mexico", "miami", "new york", "london", "tokyo", "singapore"):
            if cand in plain:
                city = cand
                break
    if not city:
        return []
    geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={urllib.parse.quote(city)}&count=1&language=es&format=json"
    geo = _http_get_json(geo_url, timeout=timeout)
    results = (geo or {}).get("results") if isinstance(geo, dict) else None
    if not results:
        return []
    top = results[0]
    lat = top.get("latitude")
    lon = top.get("longitude")
    name = top.get("name") or city
    country = top.get("country") or ""
    if lat is None or lon is None:
        return []
    fc_url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m"
    fc = _http_get_json(fc_url, timeout=timeout)
    cur = (fc or {}).get("current") if isinstance(fc, dict) else None
    if not isinstance(cur, dict):
        return []
    temp = cur.get("temperature_2m")
    feels = cur.get("apparent_temperature")
    hum = cur.get("relative_humidity_2m")
    wind = cur.get("wind_speed_10m")
    place = f"{name}, {country}".strip(", ")
    snip = f"Temperatura actual: {temp} °C (sensación {feels} °C, humedad {hum}%, viento {wind} km/h)"
    return [{
        "source": "https://open-meteo.com/",
        "title": f"Clima en {place}",
        "snippet": snip,
        "engine": "open-meteo",
    }]



def _gdelt_search(query: str, limit: int = 4, timeout: float = 8.0) -> list[dict[str, str]]:
    q = urllib.parse.quote_plus(query.strip())
    url = f"https://api.gdeltproject.org/api/v2/doc/doc?query={q}&mode=ArtList&maxrecords={max(1, min(limit, 5))}&format=json"
    data = _http_get_json(url, timeout=timeout)
    if not isinstance(data, dict):
        return []
    arts = data.get("articles")
    if not isinstance(arts, list):
        return []
    out: list[dict[str, str]] = []
    for a in arts[:limit]:
        if not isinstance(a, dict):
            continue
        title = str(a.get("title") or "").strip()
        url_a = str(a.get("url") or "").strip()
        dom = str(a.get("domain") or "").strip()
        if title and url_a:
            out.append({
                "source": url_a,
                "title": title[:120],
                "snippet": f"{dom} — {title}" if dom else title,
                "engine": "gdelt-global",
            })
    return out


def _build_queries(query: str) -> list[str]:
    original = query.strip()
    clean = re.sub(r"[¿?¡!.,:;()\[\]{}\"']+", " ", " ".join((query or "").split())).strip()
    if not clean:
        return []
    stop = {
        "que", "qué", "cuanto", "cuánto", "es", "el", "la", "los", "las", "un", "una",
        "de", "del", "en", "y", "o", "a", "por", "para", "con", "hoy", "what", "is", "the",
    }
    words = [w for w in re.findall(r"[\wáéíóúüñÁÉÍÓÚÜÑ]{2,}", clean)]
    keywords = [w for w in words if _strip_accents(w).lower() not in stop and not w.isdigit()]
    candidates: list[str] = [clean]
    if keywords:
        kw_str = " ".join(keywords)
        if kw_str.lower() != clean.lower():
            candidates.append(kw_str)
        plain_kw = _strip_accents(kw_str)
        if plain_kw.lower() not in {c.lower() for c in candidates}:
            candidates.append(plain_kw)
    low_plain = _strip_accents(clean).lower()
    if "petroleo" in low_plain:
        candidates.append("crude oil price")
    return candidates[:4]



import re as _re_kw

def _expand_direct_queries(query: str, base_queries: list[str]) -> list[str]:
    out: list[str] = []
    def _add(val: str) -> None:
        v = " ".join((val or "").split()).strip()
        if v and v not in out:
            out.append(v)

    _add(query)
    for bq in (base_queries or []):
        _add(bq)

    stop = {
        "el", "la", "los", "las", "un", "una", "unos", "unas",
        "de", "del", "al", "a", "en", "por", "para", "con", "sin",
        "y", "o", "u", "que", "qué", "como", "cómo", "cual", "cuál",
        "dame", " dime", "ver", "buscar", "busca", "este", "esta",
        "estos", "estas", "ese", "esa", "esos", "esas", "hoy", "ahora",
        "hora", "the", "a", "an", "of", "to", "in", "for", "on", "at",
    }
    cleaned = _strip_accents(query.lower())
    tokens = [
        t for t in _re_kw.findall(r"[a-z0-9]{2,}", cleaned)
        if t.strip() not in stop
    ]
    if tokens:
        _add(" ".join(tokens[:6]))
        if len(tokens) > 2:
            _add(" ".join(tokens[-4:]))
    return out

def _metal_price_search(query: str, timeout: float = 8.0) -> list[dict[str, str]]:
    q_low = _strip_accents((query or "").lower())
    if not any(k in q_low for k in ("oro", "gold", "plata", "silver", "cobre", "copper", "petroleo", "oil", "brent", "wti")):
        return []

    symbols: list[tuple[str, str]] = []
    if "oro" in q_low or "gold" in q_low:
        symbols.append(("GC=F", "Oro (Futuros / Spot USD)"))
    if "plata" in q_low or "silver" in q_low:
        symbols.append(("SI=F", "Plata (Futuros / Spot USD)"))
    if "petroleo" in q_low or "oil" in q_low or "wti" in q_low:
        symbols.append(("CL=F", "Petróleo WTI (USD)"))
    if "brent" in q_low:
        symbols.append(("BZ=F", "Petróleo Brent (USD)"))

    items: list[dict[str, str]] = []
    for sym, label in symbols:
        url = f"https://query1.finance.yahoo.com/v8/finance/chart/{urllib.parse.quote(sym)}?interval=1d&range=5d"
        req = urllib.request.Request(
            url,
            headers={
                "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/124.0.0.0 Mobile Safari/537.36",
                "Accept": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="replace"))
        except Exception:
            continue

        result = (((data or {}).get("chart") or {}).get("result")) or []
        if not result:
            continue
        meta = (result[0] or {}).get("meta") or {}
        price = meta.get("regularMarketPrice")
        prev_close = meta.get("chartPreviousClose") or meta.get("previousClose")
        currency = meta.get("currency") or "USD"
        if price is None:
            continue

        diff_txt = ""
        try:
            p_val = float(price)
            if prev_close is not None:
                c_val = float(prev_close)
                diff = p_val - c_val
                pct = (diff / c_val * 100.0) if c_val else 0.0
                sign = "+" if diff >= 0 else ""
                diff_txt = f" ({sign}{diff:.2f} / {sign}{pct:.2f}% vs cierre previo)"
            price_str = f"{p_val:,.2f} {currency}"
        except Exception:
            price_str = f"{price} {currency}"

        items.append({
            "title": f"{label}: {price_str}",
            "snippet": f"Cotización de mercado para {label} ({sym}): {price_str}{diff_txt}.",
            "source": f"https://finance.yahoo.com/quote/{urllib.parse.quote(sym)}",
            "engine": "yahoo-finance-metals",
        })
    return items


def search_web_realtime(query: str, limit: int = 5, timeout: float = 8.0) -> dict[str, Any]:
    queries = _expand_direct_queries(query, _build_queries(query))
    if not queries:
        return {"status": "NO_MATCH", "query": "", "items": [], "engines_used": []}

    tasks: list[tuple[str, Any]] = []
    for q in queries:
        tasks.append(("metals", lambda q=q: _metal_price_search(q, timeout=timeout)))
        tasks.append(("weather", lambda q=q: _weather_search(q, timeout=timeout)))
        tasks.append(("duckduckgo", lambda q=q: _ddg_search(q, limit=limit, timeout=timeout)))
        tasks.append(("wikipedia-es", lambda q=q: _wiki_search(q, lang="es", limit=3, timeout=timeout)))
        tasks.append(("wikipedia-en", lambda q=q: _wiki_search(q, lang="en", limit=2, timeout=timeout)))
        tasks.append(("hackernews", lambda q=q: _hn_search(q, limit=2, timeout=timeout)))
        tasks.append(("gdelt", lambda q=q: _gdelt_search(q, limit=3, timeout=timeout)))
        tasks.append(("yahoo-finance", lambda q=q: _yahoo_finance_search(q, limit=3, timeout=timeout)))
        tasks.append(("reddit", lambda q=q: _reddit_search(q, limit=2, timeout=timeout)))
        tasks.append(("tor", lambda q=q: _tor_network_search(q, timeout=timeout)))
        tasks.append(("custom", lambda q=q: _custom_endpoints_search(q, timeout=timeout)))

    collected: list[dict[str, str]] = []
    engines_ok: list[str] = []

    with concurrent.futures.ThreadPoolExecutor(max_workers=min(len(tasks), 10)) as pool:
        future_map = {pool.submit(fn): name for name, fn in tasks}
        try:
            for fut in concurrent.futures.as_completed(future_map, timeout=timeout + 2.5):
                name = future_map[fut]
                try:
                    rows = fut.result(timeout=0.5)
                    if rows:
                        if name not in engines_ok:
                            engines_ok.append(name)
                        collected.extend(rows)
                except Exception:
                    continue
        except concurrent.futures.TimeoutError:
            pass

    seen_keys: set[str] = set()
    deduped: list[dict[str, str]] = []
    for row in collected:
        key = (row.get("source", "") + "|" + row.get("snippet", "")[:100]).lower()
        if key in seen_keys:
            continue
        seen_keys.add(key)
        deduped.append(row)
        if len(deduped) >= limit:
            break

    if _tor_socks_addr():
        try:
            tor_items = _tor_network_search(query, timeout=max(timeout, 10.0))
        except Exception:
            tor_items = []
        if tor_items:
            for ti in tor_items:
                if isinstance(ti, dict):
                    items.append(ti)
            if "tor" not in engines_used:
                engines_used.append("tor")
            if status != "USED":
                status = "USED"

    return {
        "status": "USED" if deduped else "NO_MATCH",
        "query": queries[0],
        "items": deduped,
        "engines_used": engines_ok,
    }
