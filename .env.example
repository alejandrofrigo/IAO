APP_NAME=IAO
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://omega:change-me@db:5432/omega
AUDIT_HMAC_KEY=CHANGE_ME
MODEL_ADAPTER=disabled
PUBLIC_BASE_URL=http://localhost:8080
# Development fallback only; production requires IAO_SESSION_SIGNING_KEY.
OMEGA_DEV_TOKEN_KEY=CHANGE_ME
IAO_SESSION_SIGNING_KEY=CHANGE_ME
IAO_STATE_DIR=.state
IAO_CORPUS_DIR=docs/corpus
IAO_CORS_ORIGINS=http://localhost:5173
# Bootstrap secrets are one-time; use a secret manager and remove after enrollment.
IAO_DEVICE_ENROLLMENT_CODE=CHANGE_ME
IAO_DEVICE_ENROLLMENT_ENABLED=0
IAO_OPERATOR_BOOTSTRAP_CODE=CHANGE_ME
IAO_OPERATOR_BOOTSTRAP_EXPIRES_AT=
