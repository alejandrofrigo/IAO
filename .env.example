APP_NAME=IAO
APP_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://omega:change-me@db:5432/omega
AUDIT_HMAC_KEY=replace-with-secret-from-secret-manager
MODEL_ADAPTER=disabled
PUBLIC_BASE_URL=http://localhost:8080
# Development fallback only; production requires IAO_SESSION_SIGNING_KEY.
OMEGA_DEV_TOKEN_KEY=replace-with-a-random-32-byte-plus-development-secret
IAO_SESSION_SIGNING_KEY=replace-with-a-random-32-byte-plus-production-secret
IAO_TASK_WORKER_ENABLED=false
IAO_STATE_DIR=.state
IAO_CORPUS_DIR=docs/corpus
IAO_CORS_ORIGINS=http://localhost:5173
