{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iao-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "IAO_GATEWAY_MODE": "disabled"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASK_BROKER",
        "class_name": "TaskBroker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TaskBroker"]
    }
  ]
}
