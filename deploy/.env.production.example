# Copy to .env only after generating secrets in a trusted secret manager.
# Empty values are intentional: the API must fail closed until populated.
APP_NAME=IAO
APP_ENV=production
HOST=0.0.0.0
PORT=8080
IAO_STATE_DIR=/var/lib/iao
IAO_CORPUS_DIR=/app/knowledge
OMEGA_TOKEN_SIGNING_KEY=
AUDIT_HMAC_KEY=
IAO_CORS_ORIGINS=
MODEL_ADAPTER=disabled
IAO_AUTONOMY_WORKER_ENABLED=true

# Not yet implemented/configured by this deployment template:
# OIDC issuer, audience and JWKS verification remain a production blocker.
# Do not expose the API publicly until the identity-provider gate is closed.
