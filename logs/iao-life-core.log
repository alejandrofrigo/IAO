{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T03:04:21.518456+00:00", "cycle": 2, "goal_id": "federation", "padge_response": "{\"goal\": \"Add high‑level participant management utilities (list, get, revoke) to provide deterministic control over registered federation participants\", \"reason\": \"The federation subsystem has a participant registry but lacks a public deterministic API for querying, listing and revoking participants. Adding omega/federation_participant_management.py fills this gap, enabling operators and tests to manage participant lifecycle safely without altering existing modules.\", \"changes\": [{\"path\": \"omega/federation_participant_management.py\", \"content\": \"'''\\\\\\nHigh‑level participant management utilities for the federation subsystem.\\n\\\\\\nThis module offers a deterministic, thread‑safe API to register, list, retrieve\\nand revoke federation participants. It builds on an internal in‑memory store\\nthat records each participant's identifier, endpoint URL and current status.\\nAll operations are safe for concurrent use and raise clear exceptions on\\ninvalid usage, facilitating reliable operator tooling and automated tests.\\n'''\\\\\\n\\nfrom __future__ import annotations\\n\\nimport threading\\nfrom dataclasses import dataclass, asdict\\nfrom typing import Dict, List, Optional\\n\\n__all__ = [\\n    \\\"Participant\\\",\\n    \\\"register_participant\\\",\\n    \\\"list_participants\\\",\\n    \\\"get_participant\\\",\\n    \\\"revoke_participant\\\",\\n]\\n\\n\\n@dataclass(frozen=True)\\nclass Participant:\\n    \\\"\\\"\\\"Immutable representation of a federation participant.\\n\\n    Attributes\\n    ----------\\n    participant_id: str\\n        Unique identifier for the participant (e.g., a UUID or Ed25519 key hex).\\n    endpoint: str\\n        HTTPS URL where the participant can be reached.\\n    status: str\\n        Current lifecycle status – either ``\\\"active\\\"`` or ``\\\"revoked\\\"``.\\n    \\\"\\\"\\\"\\n\\n    participant_id: str\\n    endpoint: str\\n    status: str = \\\"active\\\"\\n\\n    def as_dict(self) -> Dict[str, str]:\\n        \\\"\\\"\\\"Return a plain ``dict`` representation for easy JSON serialisation.\\\"\\\"\\\"\\n        return asdict(self)\\n\\n\\n# ---------------------------------------------------------------------------\\n# Internal thread‑safe storage\\n# ---------------------------------------------------------------------------\\n\\n_._participants_lock = threading.Lock()\\n_._participants: Dict[str, Participant] = {}\\n\\n\\ndef register_participant(participant_id: str, endpoint: str) -> Participant:\\n    \\\"\\\"\\\"Register a new participant.\\n\\n    Parameters\\n    ----------\\n    participant_id: str\\n        Unique identifier for the participant.\\n    endpoint: str\\n        HTTPS URL of the participant.\\n\\n    Returns\\n    -------\\n    Participant\\n        The created participant record.\\n\\n    Raises\\n    ------\\n    ValueError\\n        If a participant with the same ``participant_id`` already exists.\\n    \\\"\\\"\\\"\\n    if not isinstance(participant_id, str) or not participant_id:\\n        raise ValueError(\\\"participant_id must be a non‑empty string\\\")\\n    if not isinstance(endpoint, str) or not endpoint.startswith(\\\"https://\\\"):\\n        raise ValueError(\\\"endpoint must be a valid HTTPS URL\\\")\\n\\n    with _._participants_lock:\\n        if participant_id in _._participants:\\n            raise ValueError(f\\\"Participant '{participant_id}' is already registered\\\")\\n        participant = Participant(participant_id=participant_id, endpoint=endpoint)\\n        _._participants[participant_id] = participant\\n    return participant\\n\\n\\ndef list_participants() -> List[Dict[str, str]]:\\n    \\\"\\\"\\\"Return a list of all participant records as plain dictionaries.\\n\\n    The returned list is a snapshot; modifications to the underlying registry do\\n    not affect the objects in the list.\\n    \\\"\\\"\\\"\\n    with _._participants_lock:\\n        return [p.as_dict() for p in _._participants.values()]\\n\\n\\ndef get_participant(participant_id: str) -> Optional[Dict[str, str]]:\\n    \\\"\\\"\\\"Retrieve a single participant record.\\n\\n    Parameters\\n    ----------\\n    participant_id: str\\n        Identifier of the participant to fetch.\\n\\n    Returns\\n    -------\\n    dict | None\\n        The participant data as a ``dict`` if found, otherwise ``None``.\\n    \\\"\\\"\\\"\\n    with _._participants_lock:\\n        participant = _._participants.get(participant_id)\\n        return participant.as_dict() if participant else None\\n\\n\\ndef revoke_participant(participant_id: str) -> None:\\n    \\\"\\\"\\\"Mark a participant as revoked.\\n\\n    The participant remains in the registry for auditability but its ``status``\\n    field is set to ``\\\"revoked\\\"``. Subsequent calls to ``list_participants`` or\\n    ``get_participant`` will reflect the updated status.\\n\\n    Raises\\n    ------\\n    KeyError\\n        If the participant does not exist.\\n    ValueError\\n        If the participant is already revoked.\\n    \\\"\\\"\\\"\\n    with _._participants_lock:\\n        participant = _._participants.get(participant_id)\\n        if participant is None:\\n            raise KeyError(f\\\"Participant '{participant_id}' not found\\\")\\n        if participant.status == \\\"revoked\\\":\\n            raise ValueError(f\\\"Participant '{participant_id}' is already revoked\\\")\\n        # Replace the immutable dataclass instance with a new one reflecting revocation\\n        revoked = Participant(\\n            participant_id=participant.participant_id,\\n            endpoint=participant.endpoint,\\n            status=\\\"revoked\\\",\\n        )\\n        _._participants[participant_id] = revoked\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
{"event": "LIFE_CYCLE_STARTED", "timestamp": "2026-11-10T03:19:22.358966+00:00", "cycle": 3, "goal_id": "persistent_memory", "goal": "Memoria y continuidad"}
{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T03:20:30.114401+00:00", "cycle": 3, "goal_id": "persistent_memory", "padge_response": "{\"goal\": \"Add deterministic participant revocation and listing utilities to enable operators to revoke federation participants and query participant status safely.\", \"reason\": \"The federation subsystem provides registration and onboarding of participants but lacks a high‑level, audited API to revoke a participant and to list participants filtered by revocation status. Implementing these functions fills the capability gap, supports security hygiene, and allows tests to verify participant lifecycle management without altering existing registration logic.\", \"changes\": [{\"path\": \"omega/federation_participant_revocation.py\", \"content\": \"'''omega/federation_participant_revocation.py\\n\\nUtilities to revoke federation participants and to list participants by revocation status.\\nThis module builds on the in‑memory participant registry defined in\\n`omega.federation_participant_registry`. It provides deterministic, thread‑safe\\noperations that can be used by operators and test suites.\\n'''\\n\\nimport threading\\nfrom typing import List, Dict, Optional\\n\\n# Import the internal registry structures. The registry module is expected to expose\\n# a mutable dictionary `_participants` mapping participant IDs to participant data\\n# and a lock `_registry_lock` protecting concurrent access.\\n# If the expected symbols are not present, a clear ImportError is raised.\\ntry:\\n    from .federation_participant_registry import _participants, _registry_lock\\nexcept ImportError as exc:\\n    raise ImportError(\\n        \\\"federation_participant_revocation requires `_participants` and `_registry_lock` \\\"\\n        \\\"to be defined in `omega.federation_participant_registry`\\\"\\n    ) from exc\\n\\n# Ensure the lock is a threading.Lock (or compatible) instance.\\nif not isinstance(_registry_lock, (threading.Lock, threading.RLock)):\\n    raise TypeError(\\\"_registry_lock must be a threading.Lock or RLock instance\\\")\\n\\ndef revoke_participant(participant_id: str) -> bool:\\n    \\\"\\\"\\\"Mark a registered participant as revoked.\\n\\n    Args:\\n        participant_id: The unique identifier of the participant to revoke.\\n\\n    Returns:\\n        True if the participant existed and was successfully marked revoked.\\n        False if the participant was not found in the registry.\\n    \\\"\\\"\\\"\\n    with _registry_lock:\\n        participant = _participants.get(participant_id)\\n        if participant is None:\\n            return False\\n        # Idempotent revocation – set a flag. Existing revocation is harmless.\\n        participant[\\\"revoked\\\"] = True\\n        return True\\n\\ndef is_participant_revoked(participant_id: str) -> bool:\\n    \\\"\\\"\\\"Check whether a participant is currently marked as revoked.\\n\\n    Args:\\n        participant_id: The unique identifier of the participant.\\n\\n    Returns:\\n        True if the participant exists and is revoked, False otherwise.\\n    \\\"\\\"\\\"\\n    with _registry_lock:\\n        participant = _participants.get(participant_id)\\n        return bool(participant and participant.get(\\\"revoked\\\"))\\n\\ndef list_participants(status: Optional[str] = None) -> List[Dict]:\\n    \\\"\\\"\\\"Return a list of participant records, optionally filtered by revocation status.\\n\\n    Args:\\n        status: One of ``None`` (no filtering), ``\\\"active\\\"`` (only non‑revoked),\\n            or ``\\\"revoked\\\"`` (only revoked participants).\\n\\n    Returns:\\n        A list of dictionaries representing participant metadata.\\n    \\\"\\\"\\\"\\n    with _registry_lock:\\n        participants = list(_participants.values())\\n    if status == \\\"active\\\":\\n        return [p for p in participants if not p.get(\\\"revoked\\\")]\\n    if status == \\\"revoked\\\":\\n        return [p for p in participants if p.get(\\\"revoked\\\")]\\n    return participants\\n\\n__all__ = [\\n    \\\"revoke_participant\\\",\\n    \\\"is_participant_revoked\\\",\\n    \\\"list_participants\\\",\\n]\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
