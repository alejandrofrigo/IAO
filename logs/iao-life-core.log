{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T12:21:55.648440+00:00", "cycle": 16, "goal_id": "self_programming", "padge_response": "{\"goal\": \"Agregar un registro centralizado y seguro para candidatos federados que permita alta, consulta y revocación verificadas criptográficamente, completando la infraestructura federada verificable.\", \"reason\": \"Aunque existen módulos para gestión de candidatos y firma, falta un almacén persistente (en memoria) que coordine estas operaciones y provea una API pública para listar, obtener y revocar candidatos de forma controlada y verificable, habilitando pruebas y operadores a gestionar participantes externos sin duplicar lógica.\", \"changes\": [{\"path\": \"omega/federation_candidate_registry.py\", \"content\": \"\\\"\\\"\\\"omega.federation_candidate_registry\\n~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\nMódulo que provee un registro en memoria de candidatos federados.\\n\\n- Permite registrar un candidato después de validar su firma Ed25519.\\n- Consulta candidatos activos y revocados.\\n- Revoca candidatos con razón y marca de tiempo.\\n- Es thread‑safe y está disponible como singleton a través de ``registry``.\\n\\nEste registro complementa a ``omega.federation_candidate_manager`` y a los\\nmódulos de firma/validación ya presentes en el paquete.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport datetime\\nimport threading\\nfrom dataclasses import dataclass, field\\nfrom typing import Dict, List, Optional, Tuple\\n\\n# Se asume que el módulo de firma existe y provee la función indicada.\\n# En caso de que el nombre sea distinto, el import fallará y se informará\\n# durante la carga del paquete, lo cual será detectado por las pruebas.\\ntry:\\n    from .federation_candidate_signature import verify_candidate_signature\\nexcept ImportError as exc:  # pragma: no cover\\n    raise ImportError(\\n        \\\"La dependencia 'federation_candidate_signature' es requerida para \\\"\\n        \\\"verificar firmas en federation_candidate_registry.\\\"\\n    ) from exc\\n\\n\\n@dataclass(frozen=True)\\nclass CandidateRecord:\\n    \\\"\\\"\\\"Representación inmutable de un candidato federado registrado.\\\"\\\"\\\"\\n\\n    candidate_id: str\\n    descriptor: dict\\n    signature: bytes\\n    registered_at: datetime.datetime = field(default_factory=datetime.datetime.utcnow)\\n\\n    def verify(self) -> bool:\\n        \\\"\\\"\\\"Valida la firma del candidato usando la utilidad externa.\\n\\n        Returns\\n        -------\\n        bool\\n            ``True`` si la firma es válida, ``False`` en caso contrario.\\n        \\\"\\\"\\\"\\n        return verify_candidate_signature(self.descriptor, self.signature)\\n\\n\\n@dataclass(frozen=True)\\nclass RevokedRecord:\\n    \\\"\\\"\\\"Información sobre un candidato revocado.\\\"\\\"\\\"\\n\\n    candidate_id: str\\n    reason: str\\n    revoked_at: datetime.datetime = field(default_factory=datetime.datetime.utcnow)\\n\\n\\nclass _CandidateRegistry:\\n    \\\"\\\"\\\"Singleton interno que administra el estado de candidatos.\\n\\n    La clase está diseñada para ser thread‑safe mediante un ``RLock`` que\\n    protege todas las mutaciones del diccionario interno.\\n    \\\"\\\"\\\"\\n\\n    _instance: Optional[\\\"_CandidateRegistry\\\"] = None\\n    _instance_lock = threading.Lock()\\n\\n    def __new__(cls) -> \\\"_CandidateRegistry\\\":  # pragma: no cover\\n        # Implementación del patrón singleton.\\n        if cls._instance is None:\\n            with cls._instance_lock:\\n                if cls._instance is None:\\n                    cls._instance = super().__new__(cls)\\n        return cls._instance\\n\\n    def __init__(self) -> None:\\n        # La inicialización puede ejecutarse varias veces por el patrón singleton;\\n        # aseguramos que la lógica de creación de atributos solo ocurra una vez.\\n        if getattr(self, \\\"_initialized\\\", False):\\n            return\\n        self._lock = threading.RLock()\\n        self._active: Dict[str, CandidateRecord] = {}\\n        self._revoked: Dict[str, RevokedRecord] = {}\\n        self._initialized = True\\n\\n    # ---------------------------------------------------------------------\\n    # Operaciones de gestión\\n    # ---------------------------------------------------------------------\\n    def add_candidate(self, candidate_id: str, descriptor: dict, signature: bytes) -> None:\\n        \\\"\\\"\\\"Registra un nuevo candidato después de validar su firma.\\n\\n        Parameters\\n        ----------\\n        candidate_id: str\\n            Identificador único del candidato (por ejemplo, su clave pública).\\n        descriptor: dict\\n            Descripción del candidato (capabilities, endpoints, etc.).\\n        signature: bytes\\n            Firma Ed25519 del descriptor.\\n\\n        Raises\\n        ------\\n        ValueError\\n            Si el candidato ya está registrado o la firma es inválida.\\n        \\\"\\\"\\\"\\n        with self._lock:\\n            if candidate_id in self._active:\\n                raise ValueError(f\\\"Candidato '{candidate_id}' ya está registrado y activo.\\\")\\n            if candidate_id in self._revoked:\\n                raise ValueError(f\\\"Candidato '{candidate_id}' está revocado y no puede volver a registrarse.\\\")\\n\\n            record = CandidateRecord(candidate_id=candidate_id, descriptor=descriptor, signature=signature)\\n            if not record.verify():\\n                raise ValueError(\\\"Firma del candidato no es válida.\\\")\\n            self._active[candidate_id] = record\\n\\n    def revoke_candidate(self, candidate_id: str, reason: str) -> None:\\n        \\\"\\\"\\\"Revoca un candidato activo.\\n\\n        Parameters\\n        ----------\\n        candidate_id: str\\n            Identificador del candidato a revocar.\\n        reason: str\\n            Motivo de la revocación.\\n\\n        Raises\\n        ------\\n        KeyError\\n            Si el candidato no está activo.\\n        \\\"\\\"\\\"\\n        with self._lock:\\n            if candidate_id not in self._active:\\n                raise KeyError(f\\\"Candidato '{candidate_id}' no está activo y no puede revocarse.\\\")\\n            # Eliminar de activo y registrar revocación.\\n            self._active.pop(candidate_id)\\n            self._revoked[candidate_id] = RevokedRecord(candidate_id=candidate_id, reason=reason)\\n\\n    def get_candidate(self, candidate_id: str) -> Optional[CandidateRecord]:\\n        \\\"\\\"\\\"Obtiene el registro de un candidato activo o ``None`` si no existe.\\\"\\\"\\\"\\n        with self._lock:\\n            return self._active.get(candidate_id)\\n\\n    def list_active(self) -> List[str]:\\n        \\\"\\\"\\\"Devuelve una lista de los IDs de candidatos actualmente activos.\\\"\\\"\\\"\\n        with self._lock:\\n            return list(self._active.keys())\\n\\n    def list_revoked(self) -> List[Tuple[str, str, datetime.datetime]]:\\n        \\\"\\\"\\\"Devuelve información de los candidatos revocados.\\n\\n        Cada elemento es ``(candidate_id, reason, revoked_at)``.\\n        \\\"\\\"\\\"\\n        with self._lock:\\n            return [(rec.candidate_id, rec.reason, rec.revoked_at) for rec in self._revoked.values()]\\n\\n    # ---------------------------------------------------------------------\\n    # Métodos auxiliares para depuración / pruebas\\n    # ---------------------------------------------------------------------\\n    def _clear_all(self) -> None:  # pragma: no cover\\n        \\\"\\\"\\\"Elimina todo el estado interno. Útil únicamente en pruebas internas.\\n        No debe exponerse en producción.\\n        \\\"\\\"\\\"\\n        with self._lock:\\n            self._active.clear()\\n            self._revoked.clear()\\n\\n\\n# Exposición del singleton de registro.\\nregistry = _CandidateRegistry()\\n\\n__all__ = [\\\"CandidateRecord\\\", \\\"RevokedRecord\\\", \\\"registry\\\"]\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
{"event": "LIFE_CYCLE_STARTED", "timestamp": "2026-11-10T12:37:00.507375+00:00", "cycle": 17, "goal_id": "federation", "goal": "Federación externa real"}
{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T12:37:53.897699+00:00", "cycle": 17, "goal_id": "federation", "padge_response": "{\"goal\": \"Agregar gestión de revocación de candidatos federados para permitir revocar y consultar el estado de revocación de identidades antes de su asimilación, completando la infraestructura federada verificable.\", \"reason\": \"Actualmente el subsistema no posee un mecanismo centralizado para registrar y consultar revocaciones de candidatos federados, lo que impide impedir la incorporación de participantes comprometidos o no autorizados. Un gestor de revocación sencillo, con persistencia opcional, brinda la capacidad requerida sin alterar módulos existentes.\", \"changes\": [{\"path\": \"omega/federation_revocation_manager.py\", \"content\": \"'''\\\\\\nrevocation_manager.py\\n====================\\n\\nMódulo interno que gestiona la revocación de candidatos federados.\\nProporciona una API de alto nivel, thread‑safe y con persistencia opcional en\\nun archivo JSON. Se diseñó para ser usado por los componentes de asimilación\\ny orquestación antes de aceptar una propuesta.\\n\\nUso típico::\\n\\n    from omega.federation_revocation_manager import (\\n        init_revocation_store,\\n        revoke_candidate,\\n        is_revoked,\\n        list_revoked,\\n    )\\n\\n    # Inicializar (opcionalmente con ruta de archivo persistente)\\n    init_revocation_store('/var/lib/omega/revoked_candidates.json')\\n\\n    # Revocar un candidato\\n    revoke_candidate('candidate-123')\\n\\n    # Consultar estado\\n    if is_revoked('candidate-123'):\\n        print('Candidato revocado')\\n'''\\n\\nfrom __future__ import annotations\\n\\nimport json\\nimport threading\\nfrom pathlib import Path\\nfrom typing import Set, List\\n\\n# ---------------------------------------------------------------------------\\n# Estado interno (singleton implícito)\\n# ---------------------------------------------------------------------------\\n\\n__revoked_set: Set[str] = set()\\n_lock = threading.RLock()\\n_persistence_path: Path | None = None\\n\\n\\ndef _load_from_file(path: Path) -> None:\\n    \\\"\\\"\\\"Carga el conjunto de identificadores revocados desde *path*.\\n\\n    Si el archivo no existe se considera que no hay revocaciones previas.\\n    Los errores de lectura o des‑serialización se registran mediante ``raise``\\n    para que el llamador los gestione explícitamente.\\n    \\\"\\\"\\\"\\n    if not path.is_file():\\n        return\\n    with path.open('r', encoding='utf-8') as fh:\\n        data = json.load(fh)\\n    if not isinstance(data, list):\\n        raise ValueError('Formato de revocación inválido: se esperaba una lista JSON')\\n    with _lock:\\n        _revoked_set.update(str(item) for item in data)\\n\\n\\ndef _dump_to_file(path: Path) -> None:\\n    \\\"\\\"\\\"Persiste el conjunto de revocaciones en *path* en forma de lista JSON.\\n\\n    La operación se realiza bajo el mismo lock que protege el estado interno\\n    para garantizar consistencia entre memoria y disco.\\n    \\\"\\\"\\\"\\n    with _lock:\\n        data = sorted(_revoked_set)\\n    # Escribimos de forma atómica usando rename\\n    tmp_path = path.with_suffix('.tmp')\\n    with tmp_path.open('w', encoding='utf-8') as fh:\\n        json.dump(data, fh, indent=2, sort_keys=True)\\n    tmp_path.replace(path)\\n\\n\\ndef init_revocation_store(persistence_file: str | None = None) -> None:\\n    \\\"\\\"\\\"Inicializa el gestor de revocaciones.\\n\\n    - Si *persistence_file* se proporciona, el gestor intentará cargar el\\n      contenido existente y mantendrá la ruta para posteriores escrituras.\\n    - Si es ``None`` se opera únicamente en memoria.\\n    \\n    Esta función es idempotente; llamadas subsecuentes con la misma ruta\\n    sobrescriben la configuración de persistencia pero conservan el estado\\n    actual en memoria.\\n    \\\"\\\"\\\"\\n    global _persistence_path\\n    if persistence_file is not None:\\n        path = Path(persistence_file).expanduser().resolve()\\n        _persistence_path = path\\n        _load_from_file(path)\\n    else:\\n        _persistence_path = None\\n\\n\\ndef revoke_candidate(candidate_id: str) -> None:\\n    \\\"\\\"\\\"Marca *candidate_id* como revocado.\\n\\n    Args:\\n        candidate_id: Identificador único del candidato (p. ej., hash o UUID).\\n\\n    Raises:\\n        ValueError: Si el identificador es vacío o no es una cadena.\\n    \\\"\\\"\\\"\\n    if not isinstance(candidate_id, str) or not candidate_id:\\n        raise ValueError('candidate_id debe ser una cadena no vacía')\\n    with _lock:\\n        _revoked_set.add(candidate_id)\\n        if _persistence_path is not None:\\n            _dump_to_file(_persistence_path)\\n\\n\\ndef is_revoked(candidate_id: str) -> bool:\\n    \\\"\\\"\\\"Devuelve ``True`` si *candidate_id* está en la lista de revocaciones.\\n\\n    La función es segura para ser llamada concurrentemente.\\n    \\\"\\\"\\\"\\n    if not isinstance(candidate_id, str) or not candidate_id:\\n        return False\\n    with _lock:\\n        return candidate_id in _revoked_set\\n\\n\\ndef list_revoked() -> List[str]:\\n    \\\"\\\"\\\"Retorna una lista ordenada de todos los identificadores revocados.\\n    \\\"\\\"\\\"\\n    with _lock:\\n        return sorted(_revoked_set)\\n\\n\\n# ---------------------------------------------------------------------------\\n# API de conveniencia para uso interno del paquete\\n# ---------------------------------------------------------------------------\\n\\n__all__ = [\\n    'init_revocation_store',\\n    'revoke_candidate',\\n    'is_revoked',\\n    'list_revoked',\\n]\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
