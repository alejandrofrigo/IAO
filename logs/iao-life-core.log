{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-11T06:43:07.178397+00:00", "cycle": 44, "goal_id": "resilience", "padge_response": "{\"goal\": \"Agregar una utilidad verificada para crear y validar propuestas federadas firmadas con Ed25519, completando la cadena de generación‑firma‑verificación requerida por la infraestructura federada.\", \"reason\": \"Los módulos existentes manejan generación, firma y verificación de propuestas de forma aislada y no exponen una API unificada que garantice la consistencia del proceso y la codificación canónica del payload. Esta capacidad es esencial para pruebas automáticas y para que los operadores puedan crear propuestas de manera segura sin reinventar la lógica de firma y verificación.\", \"changes\": [{\"path\": \"omega/federation_proposal_builder.py\", \"content\": \"'''omega/federation_proposal_builder.py\\n\\nUtility module to build, sign and verify federation proposals using Ed25519.\\nProvides a small, pure‑Python, dependency‑light API that can be used by the\\nhigh‑level federation workflow or directly in tests.\\n\\nThe public interface consists of two functions:\\n\\n* ``build_proposal(payload: dict, private_key: bytes) -> dict``\\n* ``verify_proposal(proposal: dict) -> bool``\\n\\nBoth functions operate on a *canonical* JSON representation of the payload –\\nsorted keys, no whitespace – ensuring that the same byte sequence is signed\\nand later verified regardless of Python dictionary ordering.\\n\\nThe module deliberately avoids any external network calls and relies only on\\nthe standard library ``json`` and ``cryptography`` (which is already a\\nruntime dependency of the project for other cryptographic operations).\\n''' \\n\\nimport json\\nfrom typing import Dict, Any\\n\\nfrom cryptography.hazmat.primitives.asymmetric import ed25519\\nfrom cryptography.exceptions import InvalidSignature\\n\\n# ---------------------------------------------------------------------------\\n# Helper functions\\n# ---------------------------------------------------------------------------\\n\\ndef _canonical_json(data: Dict[str, Any]) -> bytes:\\n    \\\"\\\"\\\"Return a deterministic JSON ``bytes`` representation.\\n\\n    The representation follows the usual federation convention:\\n    * keys are sorted alphabetically\\n    * separators are ',' and ':' without additional whitespace\\n    * UTF‑8 encoding is used\\n    \\\"\\\"\\\"\\n    # ``separators`` removes the default whitespace inserted by json.dumps\\n    canonical_str = json.dumps(data, sort_keys=True, separators=(\\\",\\\", \\\":\\\"))\\n    return canonical_str.encode(\\\"utf-8\\\")\\n\\n# ---------------------------------------------------------------------------\\n# Public API\\n# ---------------------------------------------------------------------------\\n\\ndef build_proposal(payload: Dict[str, Any], private_key: bytes) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Create a federation proposal dictionary signed with an Ed25519 private key.\\n\\n    Parameters\\n    ----------\\n    payload:\\n        Arbitrary JSON‑serialisable dictionary that represents the proposal\\n        content (e.g., ``{\\\"action\\\": \\\"add_node\\\", \\\"node_id\\\": \\\"abc123\\\"}``).\\n    private_key:\\n        32‑byte Ed25519 private key material.  The caller is responsible for\\n        secure storage and handling of this secret.\\n\\n    Returns\\n    -------\\n    dict\\n        A proposal structure with the following fields::\\n\\n            {\\n                \\\"payload\\\": <original payload dict>,\\n                \\\"signature\\\": <hex‑encoded signature>,\\n                \\\"public_key\\\": <hex‑encoded public key>\\n            }\\n    \\\"\\\"\\\"\\n    if not isinstance(payload, dict):\\n        raise TypeError(\\\"payload must be a dict\\\")\\n    if not isinstance(private_key, (bytes, bytearray)) or len(private_key) != 32:\\n        raise ValueError(\\\"private_key must be 32‑byte Ed25519 key material\\\")\\n\\n    # Create signer object\\n    signer = ed25519.Ed25519PrivateKey.from_private_bytes(bytes(private_key))\\n    public_key_bytes = signer.public_key().public_bytes()\\n\\n    # Canonical representation of the payload\\n    data_bytes = _canonical_json(payload)\\n    signature = signer.sign(data_bytes)\\n\\n    return {\\n        \\\"payload\\\": payload,\\n        \\\"signature\\\": signature.hex(),\\n        \\\"public_key\\\": public_key_bytes.hex(),\\n    }\\n\\n\\ndef verify_proposal(proposal: Dict[str, Any]) -> bool:\\n    \\\"\\\"\\\"Verify the signature of a federation proposal.\\n\\n    The function expects a dictionary produced by :func:`build_proposal`.\\n    It recomputes the canonical JSON of the embedded ``payload`` and checks the\\n    Ed25519 signature against the supplied ``public_key``.\\n\\n    Returns ``True`` if the signature is valid, ``False`` otherwise.\\n    \\\"\\\"\\\"\\n    try:\\n        payload = proposal[\\\"payload\\\"]\\n        signature_hex = proposal[\\\"signature\\\"]\\n        pubkey_hex = proposal[\\\"public_key\\\"]\\n    except (KeyError, TypeError):\\n        raise ValueError(\\\"proposal must contain 'payload', 'signature', and 'public_key' fields\\\")\\n\\n    if not isinstance(payload, dict):\\n        raise TypeError(\\\"proposal 'payload' must be a dict\\\")\\n    if not isinstance(signature_hex, str) or not isinstance(pubkey_hex, str):\\n        raise TypeError(\\\"signature and public_key must be hex string representations\\\")\\n\\n    signature = bytes.fromhex(signature_hex)\\n    pubkey_bytes = bytes.fromhex(pubkey_hex)\\n\\n    verifier = ed25519.Ed25519PublicKey.from_public_bytes(pubkey_bytes)\\n    data_bytes = _canonical_json(payload)\\n\\n    try:\\n        verifier.verify(signature, data_bytes)\\n        return True\\n    except InvalidSignature:\\n        return False\\n\\n# ---------------------------------------------------------------------------\\n# Simple self‑test (executed when the module is run directly)\\n# ---------------------------------------------------------------------------\\nif __name__ == \\\"__main__\\\":\\n    # Generate a temporary key pair for demonstration purposes\\n    private_key_obj = ed25519.Ed25519PrivateKey.generate()\\n    private_key_bytes = private_key_obj.private_bytes()\\n\\n    sample_payload = {\\\"action\\\": \\\"add_node\\\", \\\"node_id\\\": \\\"example-01\\\", \\\"timestamp\\\": 1700000000}\\n    proposal = build_proposal(sample_payload, private_key_bytes)\\n    assert verify_proposal(proposal), \\\"Self‑test failed: generated proposal did not verify\\\"\\n    print(\\\"Proposal builder self‑test passed.\\\")\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
{"event": "LIFE_CYCLE_STARTED", "timestamp": "2026-11-11T06:58:08.031685+00:00", "cycle": 45, "goal_id": "integration", "goal": "Integración del ecosistema"}
{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-11T06:59:33.955079+00:00", "cycle": 45, "goal_id": "integration", "padge_response": "{\"goal\": \"Implement candidate onboarding orchestration with validation, connectivity checking, registration, revocation and unit tests\", \"reason\": \"The federation infrastructure currently lacks a unified, testable service that discovers, validates, verifies connectivity and manages the lifecycle of federation candidates. Adding a lightweight in‑memory onboarding module and accompanying tests fills this gap, enabling reliable candidate handling without external dependencies and supporting future federation workflows.\", \"changes\": [{\"path\": \"omega/federation_candidate_onboarding.py\", \"content\": \"'''\\\\\\nCandidate onboarding orchestrator for the federated IAO network.\\n\\nProvides a high‑level, testable service that discovers, validates,\\nchecks connectivity and registers federation candidates.\\n\\nThe implementation is deliberately lightweight and does not perform\\nany external network requests beyond a TCP connectivity check to the\\ncandidate address. All state is kept in‑memory, making it suitable for\\nunit‑test environments and for integration with the existing\\ncandidate manager modules (if present).\\n'''\\\\\\n\\nimport socket\\nimport logging\\nfrom typing import Dict, Any, List\\n\\nlogger = logging.getLogger(__name__)\\n\\n# In‑memory registry of accepted candidates.\\n# Structure: {candidate_id: {\\\"address\\\": str, \\\"capabilities\\\": List[str], \\\"status\\\": str}}\\n_candidate_registry: Dict[str, Dict[str, Any]] = {}\\n\\n\\ndef _parse_address(address: str) -> tuple[str, int]:\\n    \\\"\\\"\\\"Parse an address string of the form \\\"host:port\\\".\\\"\\\"\\\"\\n    try:\\n        host, port_str = address.rsplit(\\\":\\\", 1)\\n        port = int(port_str)\\n        return host, port\\n    except Exception as exc:\\n        raise ValueError(f\\\"Invalid address format '{address}': {exc}\\\") from exc\\n\\n\\ndef discover(candidates_source: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\\n    \\\"\\\"\\\"\\n    Stub discovery function.\\n\\n    In a real deployment this would query external registries or perform\\n    network scans. For the purposes of the core library we simply return\\n    the supplied list after a shallow validation.\\n    \\\"\\\"\\\"\\n    logger.debug(\\\"Discovering candidates from supplied source.\\\")\\n    return [c for c in candidates_source if isinstance(c, dict)]\\n\\n\\ndef validate(candidate: Dict[str, Any]) -> Dict[str, Any]:\\n    \\\"\\\"\\\"\\n    Validate the minimal required fields of a candidate description.\\n\\n    Required keys:\\n        - id: unique identifier (str)\\n        - address: \\\"host:port\\\" string\\n        - capabilities: list of capability names (list of str)\\n\\n    Returns the original dict if valid, otherwise raises ``ValueError``.\\n    \\\"\\\"\\\"\\n    required = {\\\"id\\\", \\\"address\\\", \\\"capabilities\\\"}\\n    missing = required - candidate.keys()\\n    if missing:\\n        raise ValueError(f\\\"Candidate missing required fields: {missing}\\\")\\n\\n    if not isinstance(candidate[\\\"id\\\"], str):\\n        raise ValueError(\\\"Candidate 'id' must be a string\\\")\\n    if not isinstance(candidate[\\\"address\\\"], str):\\n        raise ValueError(\\\"Candidate 'address' must be a string\\\")\\n    if not isinstance(candidate[\\\"capabilities\\\"], list):\\n        raise ValueError(\\\"Candidate 'capabilities' must be a list\\\")\\n\\n    # Validate address format\\n    _parse_address(candidate[\\\"address\\\"])\\n\\n    logger.debug(\\\"Candidate %s validated successfully.\\\", candidate[\\\"id\\\"])\\n    return candidate\\n\\n\\ndef check_connectivity(candidate: Dict[str, Any], timeout: float = 1.0) -> bool:\\n    \\\"\\\"\\\"\\n    Perform a simple TCP connectivity check to the candidate address.\\n\\n    Returns ``True`` if a connection can be established, ``False`` otherwise.\\n    \\\"\\\"\\\"\\n    host, port = _parse_address(candidate[\\\"address\\\"])\\n    try:\\n        with socket.create_connection((host, port), timeout=timeout):\\n            logger.debug(\\\"Connectivity check succeeded for %s.\\\", candidate[\\\"id\\\"])\\n            return True\\n    except OSError as exc:\\n        logger.warning(\\\"Connectivity check failed for %s: %s\\\", candidate[\\\"id\\\"], exc)\\n        return False\\n\\n\\ndef register(candidate: Dict[str, Any]) -> None:\\n    \\\"\\\"\\\"\\n    Register a validated and reachable candidate in the in‑memory registry.\\n\\n    The candidate must have passed ``validate`` and ``check_connectivity``.\\n    \\\"\\\"\\\"\\n    cid = candidate[\\\"id\\\"]\\n    if cid in candidate_registry:\\n        raise ValueError(f\\\"Candidate {cid!r} is already registered\\\")\\n\\n    candidate_registry[cid] = {\\n        \\\"address\\\": candidate[\\\"address\\\"],\\n        \\\"capabilities\\\": candidate[\\\"capabilities\\\"],\\n        \\\"status\\\": \\\"registered\\\",\\n    }\\n    logger.info(\\\"Candidate %s registered.\\\", cid)\\n\\n\\ndef revoke(candidate_id: str) -> None:\\n    \\\"\\\"\\\"\\n    Revoke (remove) a candidate from the registry.\\n\\n    Raises ``KeyError`` if the candidate is not present.\\n    \\\"\\\"\\\"\\n    try:\\n        del candidate_registry[candidate_id]\\n        logger.info(\\\"Candidate %s revoked.\\\", candidate_id)\\n    except KeyError as exc:\\n        raise KeyError(f\\\"Candidate {candidate_id!r} not found\\\") from exc\\n\\n\\ndef list_registered() -> List[Dict[str, Any]]:\\n    \\\"\\\"\\\"Return a shallow copy of the registry entries.\\\"\\\"\\\"\\n    return [\\n        {\\\"id\\\": cid, **info}\\n        for cid, info in candidate_registry.items()\\n    ]\\n\\n\\ndef onboard(candidate: Dict[str, Any]) -> bool:\\n    \\\"\\\"\\\"\\n    Full onboarding workflow: validate → connectivity → register.\\n\\n    Returns ``True`` when the candidate is successfully registered,\\n    ``False`` otherwise (e.g., connectivity failure). Validation errors\\n    propagate as ``ValueError``.\\n    \\\"\\\"\\\"\\n    validate(candidate)\\n    if not check_connectivity(candidate):\\n        logger.warning(\\n            \\\"Candidate %s failed connectivity check; not registered.\\\",\\n            candidate[\\\"id\\\"],\\n        )\\n        return False\\n    register(candidate)\\n    return True\\n\"}, {\"path\": \"tools/tests/test_federation_candidate_onboarding.py\", \"content\": \"import unittest\\nimport socket\\nimport threading\\nfrom omega.federation_candidate_onboarding import (\\n    onboard,\\n    revoke,\\n    list_registered,\\n    candidate_registry,\\n)\\n\\n\\ndef _start_dummy_server(host, port):\\n    \\\"\\\"\\\"Start a minimal TCP server that accepts one connection and then exits.\\\"\\\"\\\"\\n    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\\n    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\\n    srv.bind((host, port))\\n    srv.listen(1)\\n\\n    def run():\\n        try:\\n            conn, _ = srv.accept()\\n            conn.close()\\n        finally:\\n            srv.close()\\n\\n    threading.Thread(target=run, daemon=True).start()\\n\\n\\nclass TestCandidateOnboarding(unittest.TestCase):\\n    def setUp(self):\\n        # Ensure a clean registry for each test.\\n        candidate_registry.clear()\\n\\n    def test_successful_onboard_and_revocation(self):\\n        host = \\\"127.0.0.1\\\"\\n        # Bind to an OS‑chosen free port.\\n        temp_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\\n        temp_sock.bind((host, 0))\\n        _, port = temp_sock.getsockname()\\n        temp_sock.close()\\n\\n        _start_dummy_server(host, port)\\n\\n        candidate = {\\n            \\\"id\\\": \\\"node-1\\\",\\n            \\\"address\\\": f\\\"{host}:{port}\\\",\\n            \\\"capabilities\\\": [\\\"storage\\\", \\\"compute\\\"],\\n        }\\n\\n        result = onboard(candidate)\\n        self.assertTrue(result)\\n        self.assertEqual(len(list_registered()), 1)\\n\\n        revoke(\\\"node-1\\\")\\n        self.assertEqual(len(list_registered()), 0)\\n\\n    def test_onboard_fails_connectivity(self):\\n        # Port 9 is traditionally the discard service and is unlikely to be open.\\n        candidate = {\\n            \\\"id\\\": \\\"dead-node\\\",\\n            \\\"address\\\": \\\"127.0.0.1:9\\\",\\n            \\\"capabilities\\\": [\\\"storage\\\"],\\n        }\\n        result = onboard(candidate)\\n        self.assertFalse(result)\\n        self.assertEqual(len(list_registered()), 0)\\n\\n    def test_invalid_candidate_raises(self):\\n        incomplete = {\\\"id\\\": \\\"bad\\\", \\\"address\\\": \\\"127.0.0.1:1234\\\"}\\n        with self.assertRaises(ValueError):\\n            onboard(incomplete)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
{"event": "LIFE_CYCLE_STARTED", "timestamp": "2026-11-11T07:14:34.724291+00:00", "cycle": 46, "goal_id": "self_programming", "goal": "Autoprogramación controlada"}
{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-11T07:15:10.694684+00:00", "cycle": 46, "goal_id": "self_programming", "padge_response": "{\"goal\": \"Agregar registro verificable de eventos federados para habilitar auditoría, diagnóstico y trazabilidad de actividades de descubrimiento, validación, conexión y gestión de propuestas y candidatos.\", \"reason\": \"Los módulos actuales proporcionan descubrimiento, validación, firma y gestión, pero carecen de un mecanismo centralizado de registro de eventos que permita auditar todas las operaciones federadas. Un logger de eventos en memoria, thread‑safe y con filtrado, completa la infraestructura y soporta pruebas de trazabilidad sin introducir dependencias externas ni modificar módulos existentes.\", \"changes\": [{\"path\": \"omega/federation_event_logger.py\", \"content\": \"\\\"\\\"\\\"omega.federation_event_logger\\n================================================\\nMódulo de registro de eventos federados en memoria.\\n---------------------------------------------------\\nProporciona una clase ``EventLogger`` thread‑safe que permite\\n* registrar eventos con tipo, timestamp y datos arbitrarios,\\n* consultar el historial completo o filtrado por tipo y rango de tiempo,\\n* limpiar el registro (útil en pruebas).\\n\\nEl logger está pensado para ser utilizado por los diferentes componentes\\nde la infraestructura federada (descubrimiento, validación, conectividad,\\ngestión de propuestas y candidatos) para generar una trazabilidad\\nverificable sin depender de almacenamiento persistente externo.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport threading\\nimport time\\nfrom dataclasses import dataclass, asdict\\nfrom typing import Any, Dict, List, Optional, Tuple\\n\\n__all__ = [\\\"EventLogger\\\", \\\"Event\\\"]\\n\\n\\n@dataclass(frozen=True)\\nclass Event:\\n    \\\"\\\"\\\"Representación inmutable de un evento federado.\\n\\n    Attributes\\n    ----------\\n    timestamp: float\\n        Epoch time (seconds) con resolución de sub‑segundos.\\n    event_type: str\\n        Categoría del evento (p.ej. \\\"candidate_discovered\\\", \\\"proposal_validated\\\").\\n    details: Dict[str, Any]\\n        Información estructurada asociada al evento.\\n    \\\"\\\"\\\"\\n\\n    timestamp: float\\n    event_type: str\\n    details: Dict[str, Any]\\n\\n    def as_dict(self) -> Dict[str, Any]:\\n        \\\"\\\"\\\"Devuelve una representación serializable del evento.\\\"\\\"\\\"\\n        return asdict(self)\\n\\n\\nclass EventLogger:\\n    \\\"\\\"\\\"Logger de eventos en memoria, seguro para hilos.\\n\\n    La instancia única accesible a través de ``global_logger`` se comparte\\n    entre todos los componentes federados. Cada operación se protege con un\\n    ``threading.Lock`` garantizando consistencia bajo concurrencia.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self) -> None:\\n        self._events: List[Event] = []\\n        self._lock = threading.Lock()\\n\\n    def log_event(self, event_type: str, details: Optional[Dict[str, Any]] = None) -> None:\\n        \\\"\\\"\\\"Registra un nuevo evento.\\n\\n        Parameters\\n        ----------\\n        event_type: str\\n            Tipo descriptivo del evento.\\n        details: dict | None, optional\\n            Información adicional; si es ``None`` se usa un dict vacío.\\n        \\\"\\\"\\\"\\n        if details is None:\\n            details = {}\\n        event = Event(timestamp=time.time(), event_type=event_type, details=details)\\n        with self._lock:\\n            self._events.append(event)\\n\\n    def get_events(\\n        self,\\n        *,\\n        event_type: Optional[str] = None,\\n        time_range: Optional[Tuple[float, float]] = None,\\n        limit: Optional[int] = None,\\n    ) -> List[Event]:\\n        \\\"\\\"\\\"Obtiene eventos almacenados con filtros opcionales.\\n\\n        Parameters\\n        ----------\\n        event_type: str | None\\n            Si se especifica, solo se devuelven eventos del tipo indicado.\\n        time_range: tuple(start, end) | None\\n            Intervalo de tiempo (epoch) a considerar inclusive.\\n        limit: int | None\\n            Número máximo de eventos a devolver, en orden cronológico.\\n        \\\"\\\"\\\"\\n        with self._lock:\\n            filtered = self._events\\n            if event_type is not None:\\n                filtered = [e for e in filtered if e.event_type == event_type]\\n            if time_range is not None:\\n                start, end = time_range\\n                filtered = [e for e in filtered if start <= e.timestamp <= end]\\n            if limit is not None:\\n                filtered = filtered[:limit]\\n            # Devolver copias para evitar mutación externa\\n            return list(filtered)\\n\\n    def clear(self) -> None:\\n        \\\"\\\"\\\"Elimina todos los eventos registrados.\\n\\n        Útil en entornos de pruebas para restablecer el estado.\\n        \\\"\\\"\\\"\\n        with self._lock:\\n            self._events.clear()\\n\\n    # Métodos auxiliares de conveniencia\\n    def count(self) -> int:\\n        \\\"\\\"\\\"Devuelve el número total de eventos almacenados.\\\"\\\"\\\"\\n        with self._lock:\\n            return len(self._events)\\n\\n    def latest(self) -> Optional[Event]:\\n        \\\"\\\"\\\"Devuelve el último evento registrado o ``None`` si no hay ninguno.\\\"\\\"\\\"\\n        with self._lock:\\n            return self._events[-1] if self._events else None\\n\\n\\n# Instancia global que los demás módulos pueden importar directamente\\nglobal_logger = EventLogger()\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
