{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T13:25:56.410612+00:00", "cycle": 19, "goal_id": "resilience", "padge_response": "{\"goal\": \"Agregar gestión de revocación de candidatos federados para permitir la invalidación segura y trazable de participantes autorizados\", \"reason\": \"El subsistema de federación dispone de descubrimiento, validación, generación de propuestas y seguimiento de estado, pero carece de un mecanismo estructurado para revocar candidatos comprometidos o desautorizados. Implementar un gestor de revocaciones garantiza que la red federada pueda retirar participantes de forma verificable, registrada y consultable, cumpliendo con la misión de construir una infraestructura federada segura y verificable.\", \"changes\": [{\"path\": \"omega/federation_revocation_manager.py\", \"content\": \"'''\\\\\\nrevocation_manager.py\\n---------------------\\nMódulo que provee una API sencilla y segura para revocar candidatos federados.\\n\\nCaracterísticas principales:\\n- Registro de revocaciones con timestamp, motivo y opcionalmente datos de auditoría.\\n- Consulta de estado de revocación (revocado / activo).\\n- Enumeración de todos los candidatos revocados.\\n- Purga de revocaciones antiguas para control de recursos.\\n- Integración opcional con ``omega.federation_state_tracker`` mediante eventos.\\n\\nEl diseño es deliberadamente ligero y sin dependencias externas, para que\\npueda ejecutarse en entornos con restricciones de red y sin requerir\\npersistencia permanente (se mantiene en memoria; la capa de persistencia\\npuede añadirse en el futuro).\\n'''\\\\\\n\\nfrom __future__ import annotations\\n\\nimport datetime as _dt\\nfrom dataclasses import dataclass, asdict\\nfrom typing import Dict, Iterable, List, Optional\\n\\n\\n@dataclass(frozen=True)\\nclass RevocationRecord:\\n    \\\"\\\"\\\"Representa la información asociada a una revocación de candidato.\\n\\n    Attributes\\n    ----------\\n    candidate_id: str\\n        Identificador único del candidato revocado.\\n    revoked_at: datetime.datetime\\n        Marca de tiempo (UTC) cuando se realizó la revocación.\\n    reason: str\\n        Motivo descriptivo de la revocación.\\n    metadata: dict\\n        Información adicional opcional (p. ej., quien revocó, contexto).\\n    \\\"\\\"\\\"\\n\\n    candidate_id: str\\n    revoked_at: _dt.datetime\\n    reason: str\\n    metadata: Dict[str, str] = None\\n\\n    def to_dict(self) -> Dict:\\n        \\\"\\\"\\\"Serializa el registro a un diccionario JSON‑serializable.\\\"\\\"\\\"\\n        data = asdict(self)\\n        # Convertir datetime a ISO 8601 string para serialización segura\\n        data[\\\"revoked_at\\\"] = self.revoked_at.isoformat() + \\\"Z\\\"\\n        return data\\n\\n\\nclass RevocationManager:\\n    \\\"\\\"\\\"Gestor de revocaciones en memoria.\\n\\n    La clase está pensada para ser utilizada como singleton dentro del\\n    proceso de la instancia IAO. Se pueden crear múltiples instancias si\\n    se desea aislar contextos, pero todas comparten la misma lógica.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self) -> None:\\n        # _revoked almacena candidate_id -> RevocationRecord\\n        self._revoked: Dict[str, RevocationRecord] = {}\\n        # Opcional: hook a un state tracker externo si está disponible\\n        try:\\n            from omega.federation_state_tracker import StateTracker\\n            self._state_tracker = StateTracker()\\n        except Exception:\\n            self._state_tracker = None\\n\\n    # ---------------------------------------------------------------------\\n    # API pública\\n    # ---------------------------------------------------------------------\\n    def revoke(self, candidate_id: str, reason: str, metadata: Optional[Dict[str, str]] = None) -> RevocationRecord:\\n        \\\"\\\"\\\"Registra la revocación de *candidate_id*.\\n\\n        Parameters\\n        ----------\\n        candidate_id: str\\n            Identificador único del candidato a revocar.\\n        reason: str\\n            Descripción breve del motivo de la revocación.\\n        metadata: dict, opcional\\n            Información adicional (p. ej., usuario que ejecuta la revocación).\\n\\n        Returns\\n        -------\\n        RevocationRecord\\n            El registro creado para la revocación.\\n        \\\"\\\"\\\"\\n        if not candidate_id:\\n            raise ValueError(\\\"candidate_id no puede estar vacío\\\")\\n        if not reason:\\n            raise ValueError(\\\"reason no puede estar vacío\\\")\\n\\n        now = _dt.datetime.utcnow().replace(tzinfo=_dt.timezone.utc)\\n        record = RevocationRecord(candidate_id=candidate_id, revoked_at=now, reason=reason, metadata=metadata or {})\\n        self._revoked[candidate_id] = record\\n\\n        # Notificar al state tracker si está presente\\n        if self._state_tracker is not None:\\n            try:\\n                self._state_tracker.update_state(candidate_id, \\\"revoked\\\", extra={\\\"reason\\\": reason})\\n            except Exception:\\n                # No impedir la revocación por fallos de registro\\n                pass\\n        return record\\n\\n    def is_revoked(self, candidate_id: str) -> bool:\\n        \\\"\\\"\\\"Devuelve ``True`` si *candidate_id* está registrado como revocado.\\\"\\\"\\\"\\n        return candidate_id in self._revoked\\n\\n    def get_revocation(self, candidate_id: str) -> Optional[RevocationRecord]:\\n        \\\"\\\"\\\"Obtiene el registro de revocación para *candidate_id* o ``None`` si no está revocado.\\\"\\\"\\\"\\n        return self._revoked.get(candidate_id)\\n\\n    def list_revoked(self) -> List[RevocationRecord]:\\n        \\\"\\\"\\\"Devuelve una lista de todos los registros de revocación conocidos.\\\"\\\"\\\"\\n        # Ordenar cronológicamente (más reciente al final)\\n        return sorted(self._revoked.values(), key=lambda r: r.revoked_at)\\n\\n    def purge_older_than(self, cutoff: _dt.datetime) -> int:\\n        \\\"\\\"\\\"Elimina revocaciones con *revoked_at* anterior a *cutoff*.\\n\\n        Parameters\\n        ----------\\n        cutoff: datetime.datetime (timezone-aware o naive en UTC)\\n            Marca de tiempo límite; los registros más antiguos se eliminan.\\n\\n        Returns\\n        -------\\n        int\\n            Número de registros eliminados.\\n        \\\"\\\"\\\"\\n        if cutoff.tzinfo is None:\\n            cutoff = cutoff.replace(tzinfo=_dt.timezone.utc)\\n        to_delete = [cid for cid, rec in self._revoked.items() if rec.revoked_at < cutoff]\\n        for cid in to_delete:\\n            del self._revoked[cid]\\n        return len(to_delete)\\n\\n    # ---------------------------------------------------------------------\\n    # Helpers de serialización (útiles para pruebas y auditoría)\\n    # ---------------------------------------------------------------------\\n    def export_json(self) -> List[Dict]:\\n        \\\"\\\"\\\"Exporta todos los registros como una lista de diccionarios JSON‑serializables.\\\"\\\"\\\"\\n        return [rec.to_dict() for rec in self.list_revoked()]\\n\\n    def import_json(self, data: Iterable[Dict]) -> None:\\n        \\\"\\\"\\\"Importa registros a partir de una estructura JSON‑compatible.\\n\\n        El contenido previo del gestor se sobrescribe con los registros\\n        importados. Se valida que cada elemento contenga los campos requeridos.\\n        \\\"\\\"\\\"\\n        self._revoked.clear()\\n        for entry in data:\\n            try:\\n                cid = entry[\\\"candidate_id\\\"]\\n                ts_str = entry[\\\"revoked_at\\\"]\\n                # Soportamos terminación con 'Z' o zona horaria explícita\\n                if ts_str.endswith(\\\"Z\\\"):\\n                    ts_str = ts_str.rstrip(\\\"Z\\\")\\n                revoked_at = _dt.datetime.fromisoformat(ts_str)\\n                if revoked_at.tzinfo is None:\\n                    revoked_at = revoked_at.replace(tzinfo=_dt.timezone.utc)\\n                reason = entry[\\\"reason\\\"]\\n                metadata = entry.get(\\\"metadata\\\", {})\\n                record = RevocationRecord(candidate_id=cid, revoked_at=revoked_at, reason=reason, metadata=metadata)\\n                self._revoked[cid] = record\\n            except Exception as exc:\\n                raise ValueError(f\\\"Entrada de revocación inválida: {entry}\\\") from exc\\n\\n    # ---------------------------------------------------------------------\\n    # Representación útil para depuración\\n    # ---------------------------------------------------------------------\\n    def __repr__(self) -> str:\\n        return f\\\"<RevocationManager revocations={len(self._revoked)}>\\\"\\n\\n\\n# Exportar la clase en el módulo para que el importador perezoso la descubra\\n__all__ = [\\\"RevocationManager\\\", \\\"RevocationRecord\\\"]\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
