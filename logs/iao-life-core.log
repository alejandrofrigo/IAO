{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-11T02:24:48.117917+00:00", "cycle": 31, "goal_id": "self_programming", "padge_response": "{\"goal\": \"Agregar capacidad de revocación de participantes federados con interfaz segura y pruebas automatizadas, e integrar el nuevo módulo en el loader lazy del paquete omega.\", \"reason\": \"Los módulos críticos de la infraestructura federada carecen de una forma centralizada y thread‑safe para marcar y consultar revocaciones de participantes, lo que impide la gestión completa del ciclo de vida de candidatos. Se introducen utilidades de revocación y se asegura su exposición mediante el cargador lazy, mejorando la seguridad y facilitando pruebas.\", \"changes\": [{\"path\": \"omega/federation_revocation.py\", \"content\": \"'''\\\\\\nFederation revocation utilities.\\n\\\\\\nProvides in‑memory tracking of revoked federation participants.\\nEach participant is identified by its canonical identifier\\n(e.g. Ed25519 public key string or proposal ID). The module offers\\nthread‑safe operations to revoke, query and list revocations.\\n'''\\\\\\n\\\\\\nimport threading\\\\\\nfrom typing import Set, List\\\\\\n\\\\\\n# Global revocation set protected by a lock.\\\\\\n_revoked: Set[str] = set()\\\\\\n_lock = threading.RLock()\\\\\\n\\\\\\ndef revoke_participant(participant_id: str) -> None:\\\\\\n    \\\"\\\"\\\"Mark a participant as revoked.\\\\n\\\\n    Args:\\\\n        participant_id: The unique identifier of the participant\\\\n            (public key, proposal hash, etc.).\\\\n    \\\"\\\"\\\"\\\\\\n    if not isinstance(participant_id, str):\\\\\\n        raise TypeError(\\\"participant_id must be a string\\\")\\\\\\n    with _lock:\\\\\\n        _revoked.add(participant_id)\\\\\\n\\\\\\ndef is_revoked(participant_id: str) -> bool:\\\\\\n    \\\"\\\"\\\"Return True if the participant has been revoked.\\\"\\\"\\\"\\\\\\n    if not isinstance(participant_id, str):\\\\\\n        raise TypeError(\\\"participant_id must be a string\\\")\\\\\\n    with _lock:\\\\\\n        return participant_id in _revoked\\\\\\n\\\\\\ndef list_revoked() -> List[str]:\\\\\\n    \\\"\\\"\\\"Return a snapshot list of all revoked participant identifiers.\\\"\\\"\\\"\\\\\\n    with _lock:\\\\\\n        return list(_revoked)\\\\\\n\\\\\\ndef clear_revocations() -> None:\\\\\\n    \\\"\\\"\\\"Clear all revocation records. Intended for testing only.\\\"\\\"\\\"\\\\\\n    with _lock:\\\\\\n        _revoked.clear()\"}, {\"path\": \"omega/__init__.py\", \"content\": \"'''\\\\\\nLazy loader for omega package.\\n\\\\\\nExports public sub‑modules on demand while keeping import time low.\\n'''\\\\\\n\\\\\\nfrom importlib import import_module\\\\\\nfrom types import ModuleType\\\\\\nfrom typing import List\\\\\\n\\\\\\n__all__: List[str] = [\\\\\\n    \\\"federation\\\",\\n    \\\"federation_proposals\\\",\\n    \\\"federation_assimilation\\\",\\n    \\\"federation_candidate_validator\\\",\\n    \\\"federation_connectivity\\\",\\n    \\\"federation_candidate_manager\\\",\\n    \\\"federation_state_tracker\\\",\\n    \\\"federation_orchestrator\\\",\\n    \\\"federation_manager\\\",\\n    \\\"federation_api\\\",\\n    \\\"federation_proposal_utils\\\",\\n    \\\"federation_revocation\\\",\\n]\\\\\\n\\\\\\n_module_cache: dict = {}\\\\\\n\\\\\\ndef __getattr__(name: str) -> ModuleType:\\\\\\n    if name in __all__:\\\\\\n        if name not in _module_cache:\\\\\\n            _module_cache[name] = import_module(f\\\"{__name__}.{name}\\\")\\\\\\n        return _module_cache[name]\\\\\\n    raise AttributeError(f\\\"module {__name__!r} has no attribute {name!r}\\\")\\\\\\n\\\\\\ndef __dir__() -> List[str]:\\\\\\n    return sorted(list(globals().keys()) + __all__)\"}, {\"path\": \"tools/tests/test_federation_revocation.py\", \"content\": \"import pytest\\\\\\n\\\\\\nfrom omega import federation_revocation\\\\\\n\\\\\\n@pytest.fixture(autouse=True)\\\\\\ndef clean_state():\\\\\\n    # Ensure a clean revocation set before each test\\\\\\n    federation_revocation.clear_revocations()\\\\\\n    yield\\\\\\n    federation_revocation.clear_revocations()\\\\\\n\\\\\\ndef test_revoke_and_query():\\\\\\n    participant = \\\"ed25519:ABC123\\\"\\\\\\n    assert not federation_revocation.is_revoked(participant)\\\\\\n    federation_revocation.revoke_participant(participant)\\\\\\n    assert federation_revocation.is_revoked(participant)\\\\\\n\\\\\\ndef test_list_revoked():\\\\\\n    ids = [\\\"id1\\\", \\\"id2\\\", \\\"id3\\\"]\\\\\\n    for pid in ids:\\\\\\n        federation_revocation.revoke_participant(pid)\\\\\\n    listed = federation_revocation.list_revoked()\\\\\\n    assert set(listed) == set(ids)\\\\\\n\\\\\\ndef test_invalid_identifier_type():\\\\\\n    with pytest.raises(TypeError):\\\\\\n        federation_revocation.revoke_participant(123)\\\\\\n    with pytest.raises(TypeError):\\n        federation_revocation.is_revoked(456)\\\\\\n\\\\\\ndef test_clear_revocations():\\\\\\n    federation_revocation.revoke_participant(\\\"to_clear\\\")\\\\\\n    assert federation_revocation.is_revoked(\\\"to_clear\\\")\\\\\\n    federation_revocation.clear_revocations()\\\\\\n    assert not federation_revocation.is_revoked(\\\"to_clear\\\")\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
