{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T13:58:51.538275+00:00", "cycle": 20, "goal_id": "integration", "padge_response": "{\"goal\": \"Agregar verificación de cumplimiento de políticas operativas para candidatos federados\", \"reason\": \"Los módulos existentes validan capacidades, conectividad y firma, pero no existe un mecanismo centralizado que imponga políticas de operador (ej. límites de endpoints, esquemas permitidos, antigüedad máxima). Esta capa asegura que sólo los candidatos que cumplan con reglas configurables avancen en el proceso de incorporación, reforzando la seguridad y la gobernanza de la red federada.\", \"changes\": [{\"path\": \"omega/federation_policy_enforcer.py\", \"content\": \"'''federation_policy_enforcer.py\\nMódulo de verificación de políticas operativas para candidatos federados.\\nSe integra con los validadores existentes (capacidad, conectividad) y aplica\\nrestricciones configurables como número máximo de endpoints, esquemas URL\\npermitidos y edad máxima del registro.\\n'''\\\\n\\\\nfrom __future__ import annotations\\\\n\\\\nimport time\\\\nfrom typing import Dict, List, Mapping, Any\\\\n\\\\n# Importes de módulos existentes del subsistema de federación\\\\ntry:\\\\n    from .federation_capability_validator import validate_capabilities  # noqa: F401\\\\nexcept ImportError:  # pragma: no cover\\\\n    def validate_capabilities(candidate: Mapping[str, Any]) -> None:\\\\n        \\\"\\\"\\\"Placeholder stub cuando el validador no está disponible.\\n        La función debe lanzar una excepción si la validación falla.\\n        \\\"\\\"\\\"\\\\n        pass\\\\n\\\\ntry:\\\\n    from .federation_connectivity import check_endpoints_connectivity  # noqa: F401\\\\nexcept ImportError:  # pragma: no cover\\\\n    def check_endpoints_connectivity(endpoints: List[str]) -> None:\\\\n        \\\"\\\"\\\"Placeholder stub cuando el verificador de conectividad no está disponible.\\n        Debe lanzar una excepción si algún endpoint no es accesible.\\n        \\\"\\\"\\\"\\\\n        pass\\\\n\\\\n\\\\nclass PolicyViolation(Exception):\\\\n    \\\"\\\"\\\"Excepción genérica para indicar que un candidato viola una política.\\n    \\\"\\\"\\\"\\\\n    def __init__(self, message: str, details: Dict[str, Any] | None = None):\\\\n        super().__init__(message)\\\\n        self.details = details or {}\\n\\\\n\\\\n# Política por defecto – puede ser sobrescrita por el operador en tiempo de ejecución\\\\nDEFAULT_POLICY: Dict[str, Any] = {\\\\n    \\\"max_endpoints\\\": 5,                # número máximo de URLs que un candidato puede exponer\\\\n    \\\"allowed_schemes\\\": [\\\"https\\\"],    # esquemas de URL permitidos\\\\n    \\\"max_candidate_age_seconds\\\": 30 * 24 * 60 * 60,  # 30 días\\\\n}\\\\n\\\\n\\\\ndef _validate_endpoint_schemes(endpoints: List[str], allowed_schemes: List[str]) -> None:\\\\n    \\\"\\\"\\\"Verifica que cada endpoint utilice un esquema permitido.\\n\\\\n    Args:\\\\n        endpoints: Lista de URLs del candidato.\\\\n        allowed_schemes: Esquemas aceptados (ej. ['https']).\\\\n\\\\n    Raises:\\\\n        PolicyViolation: Si algún endpoint usa un esquema prohibido.\\\\n    \\\"\\\"\\\"\\\\n    import urllib.parse\\\\n    for ep in endpoints:\\\\n        parsed = urllib.parse.urlparse(ep)\\\\n        if parsed.scheme not in allowed_schemes:\\\\n            raise PolicyViolation(\\n                f\\\"Endpoint '{ep}' usa esquema no permitido '{parsed.scheme}'.\\\",\\n                {\\\"endpoint\\\": ep, \\\"allowed_schemes\\\": allowed_schemes},\\\\n            )\\\\n\\\\n\\\\ndef _validate_endpoint_count(endpoints: List[str], max_endpoints: int) -> None:\\\\n    \\\"\\\"\\\"Asegura que no se exceda el número máximo de endpoints.\\\"\\\"\\\"\\\\n    if len(endpoints) > max_endpoints:\\\\n        raise PolicyViolation(\\n            f\\\"Número de endpoints ({len(endpoints)}) supera el límite permitido ({max_endpoints}).\\\",\\n            {\\\"count\\\": len(endpoints), \\\"max\\\": max_endpoints},\\\\n        )\\\\n\\\\n\\\\ndef _validate_candidate_age(candidate: Mapping[str, Any], max_age_seconds: int) -> None:\\\\n    \\\"\\\"\\\"Comprueba que el campo opcional 'registered_at' (timestamp UNIX) no sea demasiado antiguo.\\n\\\\n    Si el candidato no incluye 'registered_at' se asume que pasa la verificación.\\n    \\\"\\\"\\\"\\\\n    ts = candidate.get(\\\"registered_at\\\")\\\\n    if ts is None:\\n        return  # No hay información de edad; permiso implícito.\\n    if not isinstance(ts, (int, float)):\\n        raise PolicyViolation(\\n            \\\"Campo 'registered_at' debe ser un número (timestamp UNIX).\\\",\\n            {\\\"registered_at\\\": ts},\\\\n        )\\\\n    age = time.time() - float(ts)\\\\n    if age > max_age_seconds:\\n        raise PolicyViolation(\\n            f\\\"Candidato demasiado antiguo (edad {int(age)}s > máximo {max_age_seconds}s).\\\",\\n            {\\\"age_seconds\\\": age, \\\"max_allowed\\\": max_age_seconds},\\\\n        )\\\\n\\\\n\\\\ndef enforce_policy(candidate: Mapping[str, Any], policy: Mapping[str, Any] | None = None) -> None:\\\\n    \\\"\\\"\\\"Aplica todas las verificaciones de política a un descriptor de candidato.\\n\\\\n    Esta función se ejecuta antes de la generación de propuestas y la asimilación.\\\\n    Lanza ``PolicyViolation`` en caso de incumplimiento; si todo es correcto, retorna ``None``.\\\\n\\\\n    Args:\\\\n        candidate: Diccionario que describe al candidato federado. Debe contener al menos la clave ``endpoints`` (lista de URLs).\\\\n        policy: Opcional; diccionario de política a aplicar. Si se omite se usa ``DEFAULT_POLICY``.\\\\n    \\\"\\\"\\\"\\\\n    effective_policy = {**DEFAULT_POLICY, **(policy or {})}\\\\n\\\\n    # 1. Validación estructural de capacidades (campo obligatorio).\\\\n    validate_capabilities(candidate)\\\\n\\\\n    # 2. Validación de conectividad de los endpoints (offline).\\\\n    endpoints = list(candidate.get(\\\"endpoints\\\", []))\\\\n    check_endpoints_connectivity(endpoints)\\\\n\\\\n    # 3. Aplicar reglas de política operativa.\\\\n    _validate_endpoint_count(endpoints, effective_policy.get(\\\"max_endpoints\\\", 5))\\n    _validate_endpoint_schemes(endpoints, effective_policy.get(\\\"allowed_schemes\\\", [\\\"https\\\"]))\\n    _validate_candidate_age(candidate, effective_policy.get(\\\"max_candidate_age_seconds\\\", 30 * 24 * 60 * 60))\\n\\\\n    # Si llega aquí, el candidato respeta todas las políticas.\\n    return None\\\\n\\\\n\\\\n__all__: List[str] = [\\\\n    \\\"PolicyViolation\\\",\\n    \\\"DEFAULT_POLICY\\\",\\n    \\\"enforce_policy\\\",\\n]\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
{"event": "LIFE_CYCLE_STARTED", "timestamp": "2026-11-10T14:13:51.919304+00:00", "cycle": 21, "goal_id": "self_programming", "goal": "Autoprogramación controlada"}
{"event": "LIFE_CYCLE_COMPLETED", "timestamp": "2026-11-10T14:14:44.746194+00:00", "cycle": 21, "goal_id": "self_programming", "padge_response": "{\"goal\": \"Agregar módulo de descubrimiento controlado de candidatos federados que permita cargar descriptores locales, validar sus capacidades y preparar su incorporación segura.\", \"reason\": \"La infraestructura federada necesita una fuente confiable de candidatos antes de validar conectividad y generar propuestas. Sin un mecanismo de descubrimiento estructurado, los operadores deben crear manualmente listas, lo que rompe la modularidad y dificulta pruebas reproducibles. Este módulo brinda una API pública `discover_candidates` que lee archivos JSON desde un directorio autorizado, valida cada descriptor mediante el validador de capacidades existente y devuelve los candidatos listos para los siguientes pasos del flujo federado.\", \"changes\": [{\"path\": \"omega/federation_candidate_discovery.py\", \"content\": \"'''omega.federation_candidate_discovery\\n===================================\\nMódulo de descubrimiento controlado de candidatos federados.\\n\\nEste módulo expone una única función pública `discover_candidates` que:\\n\\n1. Recorre recursivamente un directorio autorizado en busca de archivos\\n   con extensión ``.json``.\\n2. Carga cada archivo como JSON y verifica que sea un diccionario.\\n3. Utiliza ``omega.federation_capability_validator`` (si está disponible) para\\n   validar la estructura y los campos obligatorios del descriptor.\\n4. Devuelve una lista de diccionarios válidos.  Los candidatos que fallen la\\n   validación se registran en ``logging`` pero no se aborta el proceso, lo que\\n   permite a los operadores inspeccionar problemas sin detener todo el flujo.\\n\\nEl descubrimiento es *offline*; no realiza llamadas a red externas y por lo\\ntanto cumple con las restricciones de política de PADGE.\\n''' \\n\\nimport json\\nimport logging\\nimport os\\nfrom pathlib import Path\\nfrom typing import List, Dict, Any\\n\\n_logger = logging.getLogger(__name__)\\n\\n# Intentamos importar el validador de capacidades.  Si el módulo no está\\n# presente (por ejemplo, en una versión anterior del repositorio), se usa una\\n# función de validación de caída que siempre devuelve ``True``.  Esto permite\\n# que el código sea importable y pruebas posteriores puedan detectar la\\n# ausencia del validador.\\ntry:\\n    from .federation_capability_validator import validate_capability\\nexcept Exception:  # pragma: no cover\\n    def validate_capability(candidate: Dict[str, Any]) -> bool:\\n        \\\"\\\"\\\"Validación de reserva que acepta cualquier descriptor.\\n\\n        En entornos donde el módulo de validación real no está disponible, se\\n        asume que la carga del descriptor es aceptable.  Los operadores deben\\n        asegurarse de que el validador esté instalado antes de usar la\\n        infraestructura productiva.\\n        \\\"\\\"\\\"\\n        _logger.warning(\\n            \\\"federation_capability_validator no disponible; se asume validez de \\\"%\\n            \\\"candidato %s\\\", candidate.get('id', '<sin-id>')\\n        )\\n        return True\\n\\n\\ndef _load_json_file(file_path: Path) -> Dict[str, Any]:\\n    \\\"\\\"\\\"Carga un archivo JSON y devuelve su contenido.\\n\\n    Args:\\n        file_path: Ruta absoluta al archivo JSON.\\n    Returns:\\n        Diccionario con el contenido del JSON.\\n    Raises:\\n        ValueError: Si el contenido no es un objeto JSON válido.\\n    \\\"\\\"\\\"\\n    try:\\n        with file_path.open('r', encoding='utf-8') as f:\\n            data = json.load(f)\\n        if not isinstance(data, dict):\\n            raise ValueError(\\\"El descriptor JSON debe ser un objeto dict.\\\")\\n        return data\\n    except json.JSONDecodeError as exc:\\n        raise ValueError(f\\\"Error de sintaxis JSON en {file_path}: {exc}\\\") from exc\\n\\n\\ndef discover_candidates(directory: str) -> List[Dict[str, Any]]:\\n    \\\"\\\"\\\"Descubre candidatos federados en un directorio local.\\n\\n    Se buscan archivos con extensión ``.json`` de manera recursiva. Cada archivo\\n    se carga y se valida con ``validate_capability``. Los candidatos válidos se\\n    añaden a la lista de resultados; los inválidos se registran y se descartan.\\n\\n    Args:\\n        directory: Ruta al directorio que contiene los descriptores JSON.\\n    Returns:\\n        Lista de descriptores de candidatos validados.\\n    Raises:\\n        FileNotFoundError: Si ``directory`` no existe o no es un directorio.\\n    \\\"\\\"\\\"\\n    base_path = Path(directory).expanduser().resolve()\\n    if not base_path.is_dir():\\n        raise FileNotFoundError(f\\\"El directorio de descubrimiento no existe: {directory}\\\")\\n\\n    candidates: List[Dict[str, Any]] = []\\n    for json_file in base_path.rglob('*.json'):\\n        try:\\n            candidate = _load_json_file(json_file)\\n        except ValueError as exc:\\n            _logger.error(\\\"Descriptor inválido en %s: %s\\\", json_file, exc)\\n            continue\\n\\n        if not validate_capability(candidate):\\n            _logger.warning(\\\"Candidato %s falló la validación de capacidades y será omitido.\\\",\\n                            candidate.get('id', '<sin-id>'))\\n            continue\\n\\n        candidates.append(candidate)\\n        _logger.debug(\\\"Candidato %s cargado y validado desde %s.\\\",\\n                      candidate.get('id', '<sin-id>'), json_file)\\n\\n    _logger.info(\\\"Descubrimiento completado: %d candidatos válidos encontrados.\\\", len(candidates))\\n    return candidates\\n\"}]}", "execution": "PADGE_RESPONSE_RECEIVED", "code_integration": "NOT_ASSERTED"}
